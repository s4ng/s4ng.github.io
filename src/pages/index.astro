---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import { formatListDate, toSlug } from '../lib/utils';

const posts = (await getCollection('blog')).sort(
  (a, b) => b.data.date.getTime() - a.data.date.getTime()
);
---

<Base title="블로그">
  <h1 class="mb-10 text-2xl font-bold">블로그</h1>

  {/* Tabular figures keep the date column aligned without resorting to a
      monospace face. */}
  <ul class="space-y-2 leading-normal">
    {
      posts.map((post) => (
        <li class="flex items-baseline gap-4">
          <time
            datetime={post.data.date.toISOString()}
            class="shrink-0 text-sm tabular-nums text-fg-muted"
          >
            {formatListDate(post.data.date)}
          </time>
          <a href={`/blog/${toSlug(post.id)}/`}>{post.data.title}</a>
        </li>
      ))
    }
  </ul>
</Base>
