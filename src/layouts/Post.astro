---
import Base from './Base.astro';
import { formatDate } from '../lib/utils';

interface Props {
  title: string;
  description?: string;
  date?: Date;
  tags?: string[];
  backHref: string;
  backLabel: string;
}

const { title, description, date, tags = [], backHref, backLabel } = Astro.props;
---

<Base title={title} description={description} type="article" publishedDate={date}>
  <a href={backHref} class="text-sm text-fg-muted hover:text-fg"
    >← {backLabel}</a
  >
  <article class="mt-6">
    <header class="mb-8">
      <h1 class="text-3xl font-bold leading-snug text-balance text-fg">{title}</h1>
      {
        (date || tags.length > 0) && (
          <div class="mt-3 flex flex-wrap items-center gap-3 text-sm text-fg-muted">
            {date && <time datetime={date.toISOString()}>{formatDate(date)}</time>}
            {tags.map((t) => (
              <span class="rounded bg-bg-elev px-2 py-0.5 text-xs">#{t}</span>
            ))}
          </div>
        )
      }
    </header>
    <div class="prose">
      <slot />
    </div>
  </article>
</Base>

<script>
  // Wrap each code block so an absolutely-positioned copy button can sit on top
  // of it without scrolling away with the <pre>'s horizontal overflow.
  for (const pre of document.querySelectorAll<HTMLPreElement>(
    '.prose pre:not(.mermaid)'
  )) {
    const source = pre.querySelector('code')?.textContent ?? pre.textContent;
    if (!source) continue;

    const wrapper = document.createElement('div');
    wrapper.className = 'code-block';
    pre.replaceWith(wrapper);
    wrapper.appendChild(pre);

    const button = document.createElement('button');
    button.type = 'button';
    button.className = 'code-copy';
    button.textContent = '복사';
    button.setAttribute('aria-label', '코드 복사');
    wrapper.appendChild(button);

    let reset: ReturnType<typeof setTimeout>;
    button.addEventListener('click', async () => {
      try {
        await navigator.clipboard.writeText(source);
        button.textContent = '복사됨';
        button.dataset.copied = '';
      } catch {
        button.textContent = '복사 실패';
      }
      clearTimeout(reset);
      reset = setTimeout(() => {
        button.textContent = '복사';
        delete button.dataset.copied;
      }, 1500);
    });
  }

  const diagrams = document.querySelectorAll<HTMLElement>('pre.mermaid');
  if (diagrams.length > 0) {
    const { default: mermaid } = await import('mermaid');
    const nodes = Array.from(diagrams);
    // mermaid.run() replaces the node's text with the rendered SVG, so keep the
    // source around: a theme switch has to draw the diagram again from scratch.
    const sources = new Map(nodes.map((node) => [node, node.textContent ?? '']));
    const media = window.matchMedia('(prefers-color-scheme: dark)');
    const isDark = () =>
      (document.documentElement.dataset.theme ??
        (media.matches ? 'dark' : 'light')) === 'dark';

    const render = () => {
      mermaid.initialize({
        startOnLoad: false,
        theme: isDark() ? 'dark' : 'default',
        securityLevel: 'strict',
        fontFamily:
          '"Pretendard Variable", Pretendard, ui-sans-serif, system-ui, "Apple SD Gothic Neo", "Malgun Gothic", "Noto Sans KR", sans-serif',
      });
      for (const node of nodes) {
        node.textContent = sources.get(node)!;
        node.removeAttribute('data-processed');
      }
      mermaid.run({ nodes });
    };

    render();
    document.addEventListener('themechange', render);
    // Follow the system only while the reader has not picked a theme.
    media.addEventListener('change', () => {
      if (!document.documentElement.dataset.theme) render();
    });
  }
</script>

<style is:global>
  .prose pre.mermaid {
    background: none !important;
    border: none;
    padding: 0;
    text-align: center;
  }
</style>
